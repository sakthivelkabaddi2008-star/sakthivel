GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
# The project documentation specifies Gemini 1.5 Pro.
# If your Google account/API currently exposes another Gemini model,
# change this value without changing the application code.
GEMINI_MODEL=gemini-1.5-pro

# Local explanation model from the project documentation.
LOCAL_EXPLANATION_MODEL=MBZUAI/LaMini-Flan-T5-783M
